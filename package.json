{
  "name": "mandala",
  "displayName": "Mandala",
  "description": "Developer diary and sprint planner inside VS Code",
  "version": "0.1.0",
  "publisher": "onetoomanybi",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "diary",
    "planner",
    "sprint",
    "story map",
    "developer"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mandala.openDashboard",
        "title": "Mandala: Open Dashboard"
      },
      {
        "command": "mandala.initWorkspace",
        "title": "Mandala: Initialize Dev-Brain Workspace"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mandala.openDashboard"
        },
        {
          "command": "mandala.initWorkspace"
        }
      ]
    },
    "configuration": {
      "title": "Mandala",
      "properties": {
        "mandala.diaryPath": {
          "type": "string",
          "default": "diary",
          "description": "Workspace-relative path to the diary folder"
        },
        "mandala.inboxPath": {
          "type": "string",
          "default": "__inbox/__todo",
          "description": "Workspace-relative path to the sprint task card folder"
        },
        "mandala.integrations.claude": {
          "type": "boolean",
          "default": true,
          "description": "Sync CLAUDE.md at workspace root from .mandala/agents/context/CLAUDE.md (symlink or generated)"
        },
        "mandala.integrations.copilot": {
          "type": "boolean",
          "default": false,
          "description": "Sync .github/copilot-instructions.md from .mandala/agents/context/COPILOT.md"
        },
        "mandala.integrations.cursor": {
          "type": "boolean",
          "default": false,
          "description": "Sync .cursorrules from .mandala/agents/context/CURSORRULES.md"
        },
        "mandala.integrations.cline": {
          "type": "boolean",
          "default": false,
          "description": "Sync .clinerules from .mandala/agents/context/CLINERULES.md"
        },
        "mandala.integrations.claudeCommands": {
          "type": "boolean",
          "default": true,
          "description": "Symlink .claude/commands/ to .mandala/agents/skills/ so skills appear as Claude Code slash commands"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "vsce package"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
    },
    "projects": [
      {
        "displayName": "host",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/src"
        ],
        "testMatch": [
          "**/lib/**/*.test.ts",
          "**/panels/**/*.test.ts",
          "**/extension.test.ts"
        ],
        "moduleNameMapper": {
          "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
        }
      },
      {
        "displayName": "webview",
        "testEnvironment": "jsdom",
        "roots": [
          "<rootDir>/src"
        ],
        "testMatch": [
          "**/webview/**/*.test.tsx",
          "**/webview/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "ts-jest",
            {
              "tsconfig": {
                "jsx": "react-jsx",
                "module": "commonjs",
                "esModuleInterop": true,
                "lib": [
                  "ES2020",
                  "DOM"
                ],
                "strict": true,
                "skipLibCheck": true,
                "types": [
                  "jest",
                  "@testing-library/jest-dom"
                ]
              }
            }
          ]
        },
        "moduleNameMapper": {
          "^vscode$": "<rootDir>/src/__mocks__/vscode.ts",
          "\\.css$": "<rootDir>/src/__mocks__/styleMock.ts"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/src/__mocks__/jest.setup.ts"
        ]
      }
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ajv": "^8.20.0",
    "css-loader": "^7.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
