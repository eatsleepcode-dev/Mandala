{
  "name": "meridian",
  "displayName": "Meridian",
  "description": "Code quality metrics and analysis powered by radon",
  "version": "0.1.0",
  "publisher": "onetoomanybi",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "radon",
    "code quality",
    "complexity",
    "metrics",
    "python"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "meridian.showPanel",
        "title": "Meridian: Show Metrics Panel"
      },
      {
        "command": "meridian.analyzeFile",
        "title": "Meridian: Analyze Current File"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "meridian.analyzeFile",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Meridian",
      "properties": {
        "meridian.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python executable used to run radon"
        },
        "meridian.complexityThreshold": {
          "type": "number",
          "default": 10,
          "description": "Cyclomatic complexity value above which a warning is shown"
        },
        "meridian.showOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh metrics when a Python file is saved"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "node ./dist/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "css-loader": "^7.0.0",
    "eslint": "^9.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
