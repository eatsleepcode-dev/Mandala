{
  "name": "mandala",
  "displayName": "Mandala",
  "description": "Developer diary and sprint planner inside VS Code",
  "version": "0.2.1",
  "publisher": "eatsleepcode-dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eatsleepcode-dev/Mandala"
  },
  "keywords": [
    "diary",
    "planner",
    "sprint",
    "story map",
    "developer"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mandala.openDashboard",
    "onCommand:mandala.initWorkspace",
    "onCommand:mandala.seedGettingStartedExamples",
    "onCommand:mandala.removeGettingStartedExamples",
    "onView:mandalaDashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mandala-explorer",
          "title": "Mandala",
          "icon": "images/mandala-outline.svg"
        }
      ]
    },
    "views": {
      "mandala-explorer": [
        {
          "type": "webview",
          "id": "mandalaDashboard",
          "name": "Dashboard",
          "icon": "images/mandala-outline.svg",
          "contextualTitle": "Mandala Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "mandala.openDashboard",
        "title": "Mandala: Open Dashboard"
      },
      {
        "command": "mandala.initWorkspace",
        "title": "Mandala: Initialize Dev-Brain Workspace"
      },
      {
        "command": "mandala.seedGettingStartedExamples",
        "title": "Mandala: Add Getting Started Examples"
      },
      {
        "command": "mandala.removeGettingStartedExamples",
        "title": "Mandala: Remove Getting Started Examples"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mandala.openDashboard"
        },
        {
          "command": "mandala.initWorkspace"
        },
        {
          "command": "mandala.seedGettingStartedExamples"
        },
        {
          "command": "mandala.removeGettingStartedExamples"
        }
      ]
    },
    "configuration": {
      "title": "Mandala",
      "properties": {
        "mandala.inboxPath": {
          "type": "string",
          "default": ".mandala/inbox",
          "description": "Workspace-relative path to the sprint task card folder (default: .mandala/inbox)",
          "order": 1
        },
        "mandala.diaryPath": {
          "type": "string",
          "default": ".mandala/diary",
          "description": "Workspace-relative path to the diary folder (default: .mandala/diary)",
          "order": 2
        },
        "mandala.sprintsPath": {
          "type": "string",
          "default": ".mandala/sprints",
          "description": "Workspace-relative path to the sprints folder (default: .mandala/sprints)",
          "order": 3
        },
        "mandala.techDebtPath": {
          "type": "string",
          "default": ".mandala/tech-debt",
          "description": "Workspace-relative path to the tech-debt folder (default: .mandala/tech-debt)",
          "order": 4
        },
        "mandala.agentsPath": {
          "type": "string",
          "default": ".mandala/agents",
          "description": "Workspace-relative path to the agents folder (default: .mandala/agents)",
          "order": 5
        },
        "mandala.themeOverride": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark",
            "neuromancer"
          ],
          "description": "Theme mode for the Mandala dashboard. 'auto' follows VS Code theme colors, 'light' and 'dark' force those palettes, and 'neuromancer' applies the cyberpunk override.",
          "order": 6
        },
        "mandala.integrations.claude": {
          "type": "boolean",
          "default": true,
          "description": "Sync CLAUDE.md at workspace root from .mandala/agents/context/CLAUDE.md (symlink or generated)",
          "order": 7
        },
        "mandala.integrations.copilot": {
          "type": "boolean",
          "default": false,
          "description": "Sync .github/copilot-instructions.md from .mandala/agents/context/COPILOT.md",
          "order": 8
        },
        "mandala.integrations.cursor": {
          "type": "boolean",
          "default": false,
          "description": "Sync .cursorrules from .mandala/agents/context/CURSORRULES.md",
          "order": 9
        },
        "mandala.integrations.cline": {
          "type": "boolean",
          "default": false,
          "description": "Sync .clinerules from .mandala/agents/context/CLINERULES.md",
          "order": 10
        },
        "mandala.integrations.claudeCommands": {
          "type": "boolean",
          "default": true,
          "description": "Symlink .claude/commands/ to .mandala/agents/skills/ so skills appear as Claude Code slash commands",
          "order": 11
        },
        "mandala.adoOrgUrl": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Organization URL (e.g. https://dev.azure.com/myorg)",
          "order": 12
        },
        "mandala.adoProject": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Project Name",
          "order": 13
        },
        "mandala.adoWorkItemType": {
          "type": "string",
          "default": "Task",
          "description": "Work Item Type to create in Azure DevOps (e.g. Task, User Story)",
          "order": 14
        },
        "mandala.thermostatApiUrl": {
          "type": "string",
          "default": "",
          "description": "The deployed endpoint URL for the Fabric Thermostat API runner.",
          "order": 15
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "npx vsce package"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
    },
    "projects": [
      {
        "displayName": "host",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/src"
        ],
        "testMatch": [
          "**/lib/**/*.test.ts",
          "**/panels/**/*.test.ts",
          "**/extension.test.ts"
        ],
        "moduleNameMapper": {
          "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
        }
      },
      {
        "displayName": "webview",
        "testEnvironment": "jsdom",
        "roots": [
          "<rootDir>/src"
        ],
        "testMatch": [
          "**/webview/**/*.test.tsx",
          "**/webview/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "ts-jest",
            {
              "tsconfig": {
                "jsx": "react-jsx",
                "module": "commonjs",
                "esModuleInterop": true,
                "lib": [
                  "ES2020",
                  "DOM"
                ],
                "strict": true,
                "skipLibCheck": true,
                "types": [
                  "jest",
                  "@testing-library/jest-dom"
                ]
              }
            }
          ]
        },
        "moduleNameMapper": {
          "^vscode$": "<rootDir>/src/__mocks__/vscode.ts",
          "\\.css$": "<rootDir>/src/__mocks__/styleMock.ts"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/src/__mocks__/jest.setup.ts"
        ]
      }
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.1",
    "ajv": "^8.20.0",
    "css-loader": "^7.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.326"
  }
}
