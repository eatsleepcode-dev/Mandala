{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./dist",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/extension.ts", "src/panels/**/*.ts", "src/lib/**/*.ts", "src/__mocks__/**/*.ts"],
  "exclude": ["node_modules", "src/webview"]
}
